{
  "install": "pnpm install",
  "terminals": [
    {
      "name": "complete-prereqs",
      "command": "set -a && [ -f .env ] && . ./.env; set +a && pnpm --filter @workspace/scripts run complete:prereqs -- --all-unfinished"
    },
    {
      "name": "completion-stay",
      "command": "set -a && [ -f .env ] && . ./.env; set +a && pnpm --filter @workspace/scripts run complete:prereqs -- --all-unfinished"
    }
  ]
}
