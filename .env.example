# Copy to `.env` at the repo root. Never commit `.env`.
DATABASE_URL=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
KEENABLE_API_KEY=
BROWSERBASE_API_KEY=
COMPLETION_MODEL=gpt-4o-mini
COMPLETION_CONCURRENCY=3

# Auth (Clerk) — a dedicated Clerk application for this project, not shared
# with CampusVal. Server-side (api-server) reads CLERK_PUBLISHABLE_KEY and
# CLERK_SECRET_KEY. The frontend build additionally needs
# VITE_CLERK_PUBLISHABLE_KEY set (same value as CLERK_PUBLISHABLE_KEY) —
# Vite only exposes VITE_-prefixed vars to client code.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
