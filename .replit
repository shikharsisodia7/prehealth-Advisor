modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Prereq Completion Worker"

[[workflows.workflow]]
name = "Prereq Completion Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd scripts && pnpm run complete:prereqs -- --all-unfinished 2>&1 | tee -a ../data/completion-worker.log"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
